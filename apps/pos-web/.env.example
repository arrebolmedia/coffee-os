# CoffeeOS POS Web - Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars-long-please-change-in-production

# App Configuration
NEXT_PUBLIC_APP_NAME=CoffeeOS POS
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Organization (for demo/development)
NEXT_PUBLIC_DEFAULT_ORG_ID=
NEXT_PUBLIC_DEFAULT_LOCATION_ID=

# Debugging
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_LOG_LEVEL=info
