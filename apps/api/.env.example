# ============================================================================
# CoffeeOS API — .env.example
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ============================================================================

# --- Node / Nest ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/coffeeos

# --- JWT ---
# Used to sign and verify ACCESS tokens (short-lived, 15m).
JWT_SECRET=
# Used to sign and verify REFRESH tokens (long-lived, 7d). MUST be different
# from JWT_SECRET so that an access token can never be replayed as a refresh.
JWT_REFRESH_SECRET=
# Optional overrides (defaults: access=15m, refresh=7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Settings encryption ---
# Required by SettingsService to encrypt is_encrypted settings (aes-256-cbc).
# No default — service refuses to start if unset.
SETTINGS_ENCRYPTION_KEY=

# --- Twilio (WhatsApp / SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155551234

# --- Mailrelay (transactional email) ---
MAILRELAY_API_KEY=
MAILRELAY_API_URL=https://api.mailrelay.com/v1
MAILRELAY_FROM_EMAIL=
MAILRELAY_FROM_NAME=

# --- CFDI / PAC (Mexican electronic invoicing) ---
PAC_API_URL=
PAC_API_KEY=
RFC_EMISOR=
NOMBRE_EMISOR=
REGIMEN_FISCAL=601
LUGAR_EXPEDICION=
